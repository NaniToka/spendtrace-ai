# Environment Variables for SpendTrace AI

# Frontend Variables
# Required in production: The base URL of the backend API
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# Backend Variables
# Comma-separated list of allowed CORS origins. Use * to allow all (not recommended for true production, but fine for hackathons).
# BACKEND_CORS_ORIGINS=http://localhost:5173,https://yourfrontend.com

# (Optional) OpenAI Key if using real AI mode (fallback synthetic mode is used otherwise)
# OPENAI_API_KEY=sk-your-openai-key-here
